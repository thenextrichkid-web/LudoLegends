# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/ludo_legends

# Redis
REDIS_URL=redis://localhost:6379/0

# JWT
JWT_SECRET_KEY=change-this-in-production
JWT_REFRESH_SECRET_KEY=change-this-in-production

# Environment
ENVIRONMENT=development

# Twilio (optional - for OTP SMS)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Referral
REFERRAL_BONUS_AMOUNT=10
